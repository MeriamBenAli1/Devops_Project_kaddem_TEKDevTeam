pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Pulling..!'
                git branch: 'AmineAkr',
                credentialsId: 'github-credentials',
                url: 'https://github.com/MeriamBenAli1/Devops_Project_kaddem_TEKDevTeam.git'
            }
        }
         stage('Maven clean') {
            steps {
                echo 'Building the project...'
                sh 'mvn clean';
            }
        }
        stage('MVN Compile') {
            steps {
                echo 'Running tests...'
                sh 'mvn compile';
            }
        }
       stage('MVN SonarQube') {
           steps {
               sh 'mvn sonar:sonar -Dsonar.login=admin -Dsonar.password=Amineakr.012a'
           }
        }
        stage('MVN Nexus') {
                    steps {
                        echo 'Deploying to Nexus...'
                        sh 'mvn deploy -DskipTests'
                    }
                }
        stage('Image') {
                    steps {
                        echo 'Création Image : ';
                        sh 'docker build -t amineakr/kaddem:1.0.0 .';
                    }
                }
        stage('Dockerhub') {
                    steps {
                        echo 'Push Image to dockerhub : ';
                        sh 'docker login -u amineakr -p Taraji.012';
                        sh 'docker push amineakr/kaddem:1.0.0';
                    }
                }
        stage('Docker-Compose') {
                    steps {
                        echo 'Staet Backend + DB : ';
                        sh 'docker compose up -d';
                    }
                }
    }

}
